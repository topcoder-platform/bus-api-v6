# Server
PORT=3000
NODE_ENV=development

# Active Topcoder Bearer-token validation
AUTH_SECRET=
VALID_ISSUERS='["https://topcoder-dev.auth0.com/","https://api.topcoder-dev.com","https://api.topcoder.com"]'

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bus-api-v6
KAFKA_TLS_ENABLED=false
KAFKA_TLS_REJECT_UNAUTHORIZED=true
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000
KAFKA_RETRY_ATTEMPTS=5
KAFKA_INITIAL_RETRY_TIME=100
KAFKA_MAX_RETRY_TIME=30000

# CORS and logging
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=
